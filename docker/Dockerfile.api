FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY packages/*/package*.json ./packages/

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build TypeScript
RUN npm run build --workspace=apps/api --if-present

EXPOSE 3001

CMD ["npm", "run", "dev", "--workspace=apps/api"]
